#!/bin/bash

if [ $# -ne 2 ]; then
    echo "usage: $0 language proj"
    exit 1
fi

echo "Building linvast-cli"
pushd CLI
dotnet publish -r linux-x64 -p:PublishSingleFile=true --self-contained false
popd

root="$PWD"
cli="$PWD/CLI/CLI/bin/Release/net8.0/linux-x64/CLI"
if [ ! -f "$cli" ]; then
    echo "not found: $cli"
    exit 1
fi
cd $1 || (echo "not found: $1"; exit 1)
cd $2 || (echo "not found: $2"; exit 1)

ts=$(date +%s)
lf="$ts.err"
succ=0
succ_loc=0
fail=0
fail_loc=0
for f in $(fd -e "$1"); do
    loc=$(cat $(realpath "$f") | wc -l)
    if "$cli" ast "$(realpath "$f")" -o /dev/null -c &>>"$root/$lf"; then
        succ=$((succ+1))
        succ_loc=$((succ_loc+loc))
    else
        fail=$((fail+1))
        fail_loc=$((fail_loc+loc))
    fi
    printf "\rsucc: %s (%s); fail: %s (%s)" $succ $succ_loc $fail $fail_loc
done
echo
