#!/bin/bash

whole_files=0
positional=()
usage() { echo "usage: $0 [--whole-files] [path ...]"; }
while [ $# -gt 0 ]; do
    case "$1" in
        --whole-files) whole_files=1; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; while [ $# -gt 0 ]; do positional+=("$1"); shift; done ;;
        -*) usage; exit 1 ;;
        *) positional+=("$1"); shift ;;
    esac
done

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [ ${#positional[@]} -eq 0 ]; then
    positional=(".")
fi

# Normalize targets to repository-relative paths. A bare language name such as
# "python" is shorthand for "lang/python"; "c/8cc" is shorthand for
# "lang/c/8cc".
normalize_target() {
    local target="$1"
    while [[ "$target" == ./* ]]; do target="${target#./}"; done
    target="${target%/}"
    case "$target" in
        ""|.) echo "." ;;
        lang|lang/*) echo "$target" ;;
        */*) echo "lang/$target" ;;
        *) echo "lang/$target" ;;
    esac
}

targets=()
for requested in "${positional[@]}"; do
    normalized="$(normalize_target "$requested")"
    case "$normalized" in
        /*|../*|*/../*|*/..) echo "path must be inside the repository: $requested" >&2; exit 1 ;;
    esac
    targets+=("$normalized")
done

# Always fetch the CLI needed to run the evaluation. Fetch only language
# submodules related to the requested paths; selecting the repository root or
# lang/ selects all language submodules.
submodule_paths=("CLI")
missing_gitlinks=()
if ! module_entries="$(git -C "$root" config -f .gitmodules --get-regexp '^submodule\..*\.path$')"; then
    echo "failed to read submodule configuration" >&2
    exit 1
fi
while read -r _ module_path; do
    [ -z "$module_path" ] && continue
    [ "$module_path" = "CLI" ] && continue
    for target in "${targets[@]}"; do
        if [ "$target" = "." ] || [ "$target" = "lang" ] || \
            [ "$module_path" = "$target" ] || \
            [[ "$module_path" == "$target/"* ]] || \
            [[ "$target" == "$module_path/"* ]]; then
            if ! index_entry="$(git -C "$root" ls-files --stage -- "$module_path")"; then
                echo "failed to inspect submodule: $module_path" >&2
                exit 1
            fi
            case "$index_entry" in
                160000\ *) submodule_paths+=("$module_path") ;;
                *) missing_gitlinks+=("$module_path") ;;
            esac
            break
        fi
    done
done <<< "$module_entries"

if [ ${#missing_gitlinks[@]} -gt 0 ]; then
    echo "these requested submodules are listed in .gitmodules but are not recorded as gitlinks in this checkout:" >&2
    printf '  %s\n' "${missing_gitlinks[@]}" >&2
    echo "Commit and push the submodule entries in the parent repository, then update or reclone it." >&2
    exit 1
fi

initialize_all=0
update_paths=("CLI")
for target in "${targets[@]}"; do
    if [ "$target" = "." ] || [ "$target" = "lang" ]; then
        initialize_all=1
        break
    fi

    language_path="${target#lang/}"
    if [[ "$language_path" != */* ]]; then
        # Use the language directory as one pathspec; Git then selects all
        # tracked submodules below it.
        update_paths+=("$target")
        continue
    fi

    # For a project path (or a directory inside one), update its containing
    # submodule. This also handles paths nested below a submodule root.
    for module_path in "${submodule_paths[@]}"; do
        [ "$module_path" = "CLI" ] && continue
        if [ "$module_path" = "$target" ] || \
            [[ "$module_path" == "$target/"* ]] || \
            [[ "$target" == "$module_path/"* ]]; then
            update_paths+=("$module_path")
        fi
    done
done

if [ "$initialize_all" = "1" ]; then
    echo "Initializing all submodules"
    update_cmd=(git -C "$root" submodule update --init --recursive)
else
    echo "Initializing submodules: ${update_paths[*]}"
    update_cmd=(git -C "$root" submodule update --init --recursive -- "${update_paths[@]}")
fi
if ! "${update_cmd[@]}"; then
    echo "failed to initialize required submodules" >&2
    exit 1
fi

# The runner checks extraction exit statuses before consuming JSONL and records
# distinct CLI outcomes. Keep corpus evaluation out of process substitutions.
runner_args=()
if [ "$whole_files" = "1" ]; then
    runner_args+=(--whole-files)
fi
exec python3 "$root/evaluation.py" "${runner_args[@]}" "${targets[@]}"
